---
import Text from './Text.astro';
import { hrefFor, type Locale } from '../i18n';
const { eyebrow, title, href, label } = Astro.props;
const locale = (Astro.currentLocale ?? 'zh') as Locale;
---

<div class="section-heading">
  <div>
    <p class="eyebrow">
      <Text text={eyebrow} />
    </p>
    <h2>
      <Text text={title} />
    </h2>
  </div>
  {href && (
    <a class="text-link" href={hrefFor(href, locale)}>
      <Text text={label} /> <span aria-hidden="true">↗</span>
    </a>
  )}
</div>
