---
import Text from './Text.astro';
const { eyebrow, title, href, label } = Astro.props;
---

<div class="section-heading">
  <div>
    <p class="eyebrow">
      <Text text={eyebrow} />
    </p>
    <h2>
      <Text text={title} />
    </h2>
  </div>
  {href && (
    <a class="text-link" href={href}>
      <Text text={label} /> <span aria-hidden="true">↗</span>
    </a>
  )}
</div>
