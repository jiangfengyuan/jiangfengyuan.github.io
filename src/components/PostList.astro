---
import type { CollectionEntry } from 'astro:content';
import Text from './Text.astro';
import { hrefFor, postSlug, type Locale } from '../i18n';
interface Props {
  posts: CollectionEntry<'posts'>[];
  searchable?: boolean;
}
const { posts, searchable = false } = Astro.props;
const locale = (Astro.currentLocale ?? 'zh') as Locale;
const postHref = (post: CollectionEntry<'posts'>) => hrefFor(`/blog/${postSlug(post)}/`, locale);
// Same rule as ArticlePage's table of contents; the opening skeleton mirrors that layout.
const hasToc = (post: CollectionEntry<'posts'>) =>
  ((post.rendered?.metadata?.headings ?? []) as { depth: number }[]).some(
    (h) => h.depth === 2 || h.depth === 3,
  );
---

<div class="post-list">
  {posts.map((post, i) => (
    <article
      class="post-row"
      data-post={searchable ? '' : undefined}
      data-search={(
        post.data.title +
        ' ' +
        post.data.summary +
        ' ' +
        post.data.tags.join(' ')
      ).toLocaleLowerCase()}
      data-tags={JSON.stringify(post.data.tags)}
    >
      <div class="post-row-index" aria-hidden="true">
        {String(i + 1).padStart(2, '0')}
      </div>
      <div class="post-row-body">
        <div class="post-meta">
          <time datetime={post.data.date}>{post.data.date.replaceAll('-', '.')}</time>
          <span>{post.data.tags.join(' / ')}</span>
          <span class="language-note">
            <Text
              text={{
                zh: post.data.language === 'zh' ? '中文原文' : '英文原文',
                en: post.data.language === 'zh' ? 'In Chinese' : 'In English',
              }}
            />
          </span>
        </div>
        <h3>
          <a
            href={postHref(post)}
            data-article-link
            data-article-toc={hasToc(post) ? '' : undefined}
          >
            {post.data.title}
          </a>
        </h3>
        <p>{post.data.summary}</p>
      </div>
      <a
        class="post-row-arrow"
        href={postHref(post)}
        aria-label={post.data.title}
        data-article-link
        data-article-toc={hasToc(post) ? '' : undefined}
      >
        <span aria-hidden="true">↗</span>
      </a>
    </article>
  ))}
</div>
