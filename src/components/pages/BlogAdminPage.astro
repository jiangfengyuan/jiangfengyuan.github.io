---
import Base from '../../layouts/Base.astro';
import Text from '../Text.astro';
const BlogAdminImport = import.meta.env.DEV
  ? (await import('../BlogAdminImport.astro')).default
  : null;
---

<Base title="文章导入工具 — Hayden" titleEn="Article import — Hayden" noindex active="blog">
  <div class="container">
    <header class="page-hero">
      <p class="eyebrow">WRITING WORKSPACE</p>
      <h1>
        <Text text={{ zh: '从粘贴，到一篇文章。', en: 'From a paste to a post.' }} />
      </h1>
      <p class="lead">
        <Text
          text={{
            zh: '粘贴公众号正文或使用 Markdown 写作。内容在浏览器中整理，导出后可交给仓库或 Pages CMS。',
            en: 'Paste a WeChat article or write in Markdown. Prepare content in your browser, then export it to the repository or Pages CMS.',
          }}
        />
      </p>
      <div class="actions">
        <a class="btn" href="https://app.pagescms.org/">
          <Text text={{ zh: '打开内容管理', en: 'Open content manager' }} /> ↗
        </a>
      </div>
    </header>
    {
      import.meta.env.DEV && BlogAdminImport ? (
        <BlogAdminImport />
      ) : (
        <section class="section">
          <p class="notice">
            <Text
              text={{
                zh: '导入工具仅在本地开发环境可用。请使用 Pages CMS 或直接编辑 src/content/posts/ 下的 Markdown 文件。',
                en: 'The import tool is only available in the local development environment. Please use Pages CMS or edit Markdown files under src/content/posts/.',
              }}
            />
          </p>
        </section>
      )
    }
  </div>
</Base>
