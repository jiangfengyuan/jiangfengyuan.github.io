---
import Text from './Text.astro';
import CopyEmail from './CopyEmail.astro';
import { profile } from '../data/content';
import { hrefFor, type Locale } from '../i18n';
const locale = (Astro.currentLocale ?? 'zh') as Locale;
const newTab = (name: string) =>
  locale === 'zh' ? `${name}（在新标签页打开）` : `${name} (opens in a new tab)`;
---

<footer class="site-footer container">
  <div class="footer-top">
    <a class="wordmark" href={hrefFor('/', locale)}>
      hayden
      <span class="wordmark-dot" aria-hidden="true">
        .
      </span>
    </a>
    <p>
      <Text text={{ zh: '保持好奇，慢慢创造。', en: 'Stay curious. Make something thoughtful.' }} />
    </p>
    <div class="footer-contact">
      <a class="text-link" href={'mailto:' + profile.email}>
        {profile.email} ↗
      </a>
      <CopyEmail />
    </div>
  </div>
  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} Hayden</span>
    <div>
      <a
        href={profile.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={newTab('GitHub')}
      >
        GitHub ↗
      </a>
      <a
        href={profile.bilibili}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={newTab('Bilibili')}
      >
        Bilibili ↗
      </a>
      <a href={hrefFor('/dhgt/', locale)}>DHGT</a>
      <a href="/rss.xml">RSS</a>
      <a class="back-top" href="#main-content" data-back-top>
        <Text text={{ zh: '返回页首', en: 'Back to top' }} />
        <span aria-hidden="true">↑</span>
      </a>
    </div>
    <span>
      <Text text={{ zh: '用心设计，持续生长。', en: 'Made with care. Always growing.' }} />
    </span>
  </div>
</footer>
