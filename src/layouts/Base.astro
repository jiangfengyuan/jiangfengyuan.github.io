---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Text from '../components/Text.astro';
import { profile, site } from '../data/content';
import { pathForLocale } from '../i18n';
import type { Locale } from '../i18n';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/pages.css';
import '../styles/spatial.css';
import '../styles/details.css';
import '../styles/navigation.css';
import '../styles/article-open.css';
import '../styles/dhgt.css';
interface Props {
  title: string;
  titleEn?: string;
  description?: { zh: string; en: string };
  image?: string;
  active?: string;
  noindex?: boolean;
  type?: string;
}
const {
  title,
  titleEn = title,
  description = profile.description,
  image = '/assets/social/index.png',
  active = '',
  noindex = false,
  type = 'website',
} = Astro.props;
const locale = (Astro.currentLocale ?? 'zh') as Locale;
const pageTitle = locale === 'en' ? titleEn : title;
const pageDescription = locale === 'en' ? description.en : description.zh;
const canonical = new URL(Astro.url.pathname, site).href;
const zhPath = pathForLocale(Astro.url.pathname, 'zh');
const enPath = pathForLocale(Astro.url.pathname, 'en');
const zhHref = new URL(zhPath, site).href;
const enHref = new URL(enPath, site).href;
const rssHref = locale === 'en' ? '/en/rss.xml' : '/rss.xml';
---

<!doctype html>
<html lang={locale === 'zh' ? 'zh-CN' : 'en'} data-lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content="Hayden" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-CN" href={zhHref} />
    <link rel="alternate" hreflang="en-US" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={zhHref} />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/assets/favicon.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Hayden — Writing" href={rssHref} />
    <meta name="theme-color" content="#f6f4ef" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Hayden" />
    <meta property="og:locale" content={locale === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={new URL(image, site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={new URL(image, site).href} />
    <ClientRouter />
    <script is:inline>
      try {
        const t = localStorage.getItem('site-theme');
        document.documentElement.dataset.theme =
          t === 'light' || t === 'dark'
            ? t
            : matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
      } catch {
        document.documentElement.dataset.theme = matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light';
      }
      document.documentElement.dataset.js = '';
      const themeColorMeta = document.querySelector('meta[name="theme-color"]');
      if (themeColorMeta) {
        themeColorMeta.content =
          document.documentElement.dataset.theme === 'dark' ? '#191c19' : '#f6f4ef';
      }
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      <Text text={{ zh: '跳至正文', en: 'Skip to content' }} />
    </a>
    <Header active={active} />
    <main id="main-content" tabindex="-1" transition:name="page-content">
      {locale === 'zh' && (
        <aside class="lang-hint container" data-lang-hint lang="en" hidden>
          <p>This page is also available in English.</p>
          <a class="text-link" href={enPath} data-lang-hint-link>
            Read in English →
          </a>
          <button class="icon-button" type="button" data-lang-hint-close aria-label="Dismiss">
            ×
          </button>
        </aside>
      )}
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
